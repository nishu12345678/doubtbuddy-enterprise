OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Used for JEE Advanced or an explicit advanced difficulty selection. Empty disables routing.
OPENAI_REASONING_MODEL=gpt-5-mini
ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
PORT=3001
PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
DATABASE_PATH=./data/doubtbuddy.sqlite
# Set to true only for an explicitly labelled local demonstration. No OpenAI requests.
DEMO_MODE=false
